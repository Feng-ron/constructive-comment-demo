{
  "manifest_version": 3,
  "name": "建設的コメント（デモ）",
  "version": "0.1.0",
  "description": "建設性スコアで YouTube コメントを並べ替え・フィルタします（ローカル API が必要です）。",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
